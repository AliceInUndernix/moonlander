{
    "exclude_entry": false,
    "exit_on_mismatch": true,
    "exit_on_match": false,
    "ignore_folding": true,
    "entry": {
        "#TPH-F": "{#Left}{^}",
        "#TPH*F": "{#Shift_l(Left)}{^}",
        "#TPH-P": "{#Down}{^}",
        "#TPH*P": "{#Shift_l(Down)}{^}",
        "#TPH-L": "{#Up}{^}",
        "#TPH*L": "{#Shift_l(Up)}{^}",
        "#TPH-T": "{#Right}{^}",
        "#TPH*T": "{#Shift_l(Right)}{^}",
        "#TPH-R": "{#Control_l(Left)}{^}",
        "#TPH*R": "{#Control_l(Shift_l(Left))}{^}",
        "#TPH-B": "{#Page_Down}{^}",
        "#TPH*B": "{#Shift_l(Page_Down)}{^}",
        "#TPH-G": "{#Page_Up}{^}",
        "#TPH*G": "{#Shift_l(Page_Up)}{^}",
        "#TPH-S": "{#Control_l(Right)}{^}",
        "#TPH*S": "{#Control_l(Shift_l(Right))}{^}",
        "#TPH-FR": "{#Home}{^}",
        "#TPH*FR": "{#Shift_l(Home)}{^}",
        "#TPH-TS": "{#End}{^}",
        "#TPH*TS": "{#Shift_l(End)}{^}",
        "#TPH-LG": "{#Control_l(Home)}{^}",
        "#TPH*LG": "{#Control_l(Shift_l(Home))}{^}",
        "#TPH-PB": "{#Control_l(End)}{^}",
        "#TPH*PB": "{#Control_l(Shift_l(End))}{^}",
        "STPH-F": "{#Left}{^}",
        "STPH*F": "{#Shift_l(Left)}{^}",
        "STPH-P": "{#Down}{^}",
        "STPH*P": "{#Shift_l(Down)}{^}",
        "STPH-L": "{#Up}{^}",
        "STPH*L": "{#Shift_l(Up)}{^}",
        "STPH*T": "{#Shift_l(Right)}{^}",
        "STPH-R": "{#Control_l(Left)}{^}",
        "STPH*R": "{#Control_l(Shift_l(Left))}{^}",
        "STPH-B": "{#Page_Down}{^}",
        "STPH*B": "{#Shift_l(Page_Down)}{^}",
        "STPH-G": "{#Page_Up}{^}",
        "STPH*G": "{#Shift_l(Page_Up)}{^}",
        "STPH*S": "{#Control_l(Shift_l(Right))}{^}",
        "STPH-FR": "{#Home}{^}",
        "STPH*FR": "{#Shift_l(Home)}{^}",
        "STPH*TS": "{#Shift_l(End)}{^}",
        "STPH-LG": "{#Control_l(Home)}{^}",
        "STPH*LG": "{#Control_l(Shift_l(Home))}{^}",
        "STPH-PB": "{#Control_l(End)}{^}",
        "STPH*PB": "{#Control_l(Shift_l(End))}{^}"
    },
    "dict": {
        "-F": "{#Left}{^}",
        "*F": "{#Shift_l(Left)}{^}",
        "-P": "{#Down}{^}",
        "*P": "{#Shift_l(Down)}{^}",
        "-L": "{#Up}{^}",
        "*L": "{#Shift_l(Up)}{^}",
        "-T": "{#Right}{^}",
        "*T": "{#Shift_l(Right)}{^}",
        "-R": "{#Control_l(Left)}{^}",
        "*R": "{#Control_l(Shift_l(Left))}{^}",
        "-B": "{#Page_Down}{^}",
        "*B": "{#Shift_l(Page_Down)}{^}",
        "-G": "{#Page_Up}{^}",
        "*G": "{#Shift_l(Page_Up)}{^}",
        "-S": "{#Control_l(Right)}{^}",
        "*S": "{#Control_l(Shift_l(Right))}{^}",
        "-FR": "{#Home}{^}",
        "*FR": "{#Shift_l(Home)}{^}",
        "-TS": "{#End}{^}",
        "*TS": "{#Shift_l(End)}{^}",
        "-LG": "{#Control_l(Home)}{^}",
        "*LG": "{#Control_l(Shift_l(Home))}{^}",
        "-PB": "{#Control_l(End)}{^}",
        "*PB": "{#Control_l(Shift_l(End))}{^}"
    }
}